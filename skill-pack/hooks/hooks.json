{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bot_background_gate.py\"" }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Gmail__send_message",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bot_mail_gate.py\"" }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Google_Calendar__(create|update|delete)_event",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bot_calendar_gate.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude_ai_Google_Calendar__create_event",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bot_calendar_ledger.py\"" }
        ]
      }
    ]
  }
}
