# Copy to .env and edit — or just run `npm run setup`, which fills this in and
# validates every answer as it goes.
#
# A bot answers on Discord when it has a DISCORD_TOKEN, and on any Paperclip
# board it is given; it needs at least one. Everything else has a working default.
# Full reference: the config table in README.md. Check your setup: npm run doctor

# ── Surfaces: Discord and/or Paperclip ────────────────────────────────────────

# Where this bot answers: discord, paperclip, or discord,paperclip. Unset: on
# Discord if DISCORD_TOKEN is set, plus any Paperclip board below; with neither
# the bot refuses to start. A declared surface is a prerequisite:
# paperclip needs the Paperclip connector enabled first (PAPERCLIP_URL and
# PAPERCLIP_API_KEY, or PAPERCLIP_EXTRA_BOARDS), or the bot refuses to start.
# BOT_SURFACES=paperclip

# Discord Developer Portal -> your app -> Bot -> Reset Token
# Required when BOT_SURFACES names discord. A Paperclip-only bot leaves it
# unset (BOT_SURFACES is then optional): Discord stays off, scheduled jobs are refused, and the bot answers on
# its board(s) alone. Paperclip-only example:
#   CLAUDE_CWD=/path/to/your/project-repo
#   BOT_NAME=tech-lead
#   WS_PORT=9803
#   BOT_SURFACES=paperclip
#   PAPERCLIP_URL=https://board.example.com
#   PAPERCLIP_API_KEY=<this agent's own key>
DISCORD_TOKEN=your-discord-bot-token-here

# ── Identity ──────────────────────────────────────────────────────────────────

# YOUR project directory — the repo holding the CLAUDE.md that gives this bot its
# role. This is NOT the harness directory. Startup fails if it does not exist.
CLAUDE_CWD=/path/to/your/project-repo

# Instance name. Scopes this bot's pid, log and session files. Required if you
# run more than one bot from one clone.
# BOT_NAME=bot

# Path to .mcp.json, if it is not in CLAUDE_CWD.
# MCP_CONFIG=

# Skills that ship WITH the harness and load into every bot, namespaced
# /slashbin-harness:<name>. Set empty to disable; add your own packs alongside.
# BOT_SKILL_PACK=
# BOT_EXTRA_SKILL_PACKS=

# ── Access control ────────────────────────────────────────────────────────────

# Discord user IDs allowed to drive this bot, comma-separated.
# EMPTY MEANS EVERY USER who can DM it or post in a channel it watches.
# (Discord -> Settings -> Advanced -> Developer Mode, then right-click your name.)
ALLOWED_USERS=

# Refuse to start rather than run open to everyone.
# BOT_REQUIRE_ALLOWLIST=false

# Channels answered without an @mention. DMs always work.
MONITOR_CHANNELS=

# If set, the bot only responds in these channels, even when @mentioned.
# ALLOWED_CHANNELS=

# Peer bot user IDs allowed to interact (bot-to-bot). Both bots must list each
# other. Humans are gated by ALLOWED_USERS; bots by this.
# ALLOWED_BOTS=
# MAX_BOT_EXCHANGES=2

# ── What the bot may do ───────────────────────────────────────────────────────

# restricted (default) — only BOT_ALLOWED_TOOLS, plus any connected MCP tools
# bypass               — every tool, no permission checks
# Use bypass only for a bot you intend to let write code and run commands, and
# only alongside a real ALLOWED_USERS.
# BOT_PERMISSION_MODE=restricted
#
# What every run inherits from this bot's process. Unset, a run gets the whole
# environment the bot was started with — under pm2 that is the launching shell,
# every credential in it included. Set, a run gets only the operating basics
# (PATH, HOME, locale, TMPDIR, XDG_*, CODEX_HOME), the harness's own settings
# (mail, calendar and landing policies, BOT_* paths, commit identity), and the
# names listed; a name ending in * keeps a prefix. It limits credentials, never
# policy. A kept credential is for MCP servers only: a Codex run's commands
# never see it. A harness setting holding a credential's value refuses the
# configuration at startup. For a bot that must hold only its own keys.
# BOT_RUN_ENV=NOVA_SLASHBIN_MCP_ROUTER_BEARER,GH_CONFIG_DIR,DOPPLER_CONFIG_DIR
# BOT_ALLOWED_TOOLS=Read,Glob,Grep,WebFetch,WebSearch,TodoWrite
# BOT_SUMMARIZER_TOOLS=Read

# ── Agent runtime ─────────────────────────────────────────────────────────────

# Which agent CLI this bot runs on: claude (default) or codex. Every run uses it —
# Discord, scheduled jobs, summaries, board tasks. No fallback between them; after
# a switch each channel starts a fresh session. docs/runtimes.md
# BOT_RUNTIME=claude
# BOT_MODEL=                    # the selected runtime's model; the CLI default if unset
# CLAUDE_MODEL=claude-opus-5    # Claude only, used when BOT_MODEL is unset
# SUMMARIZE_MODEL=claude-haiku-5-5   # a cheaper model of the same runtime is fine
# BOT_BOARD_MODEL=claude-sonnet-5-5  # Paperclip task runs; unset = the bot's model
# BOT_JOB_MODEL=claude-sonnet-5-5    # scheduled-job runs; unset = the bot's model
# CLAUDE_BIN=claude
# CODEX_BIN=codex               # signed in with `codex login`
# CLAUDE_MAX_TURNS=100          # steps per request before it reports a cap-out; 0 = no cap (timeout bounds the run)
# CLAUDE_TIMEOUT_MS=3600000     # max wall time per request (1h)
# SESSION_TIMEOUT_MS=1800000    # idle time before a channel starts fresh (30m)
# MAX_CONCURRENT_CLAUDE=2       # requests in flight before new ones are refused
# BOT_SYSTEM_PROMPT=            # override the built-in harness prompt

# The bot's sense of "today". IANA name; defaults to the host timezone.
# BOT_TIMEZONE=America/Chicago

# ── Memory ────────────────────────────────────────────────────────────────────

# ONE root for everything this bot remembers (buffer, sessions, and the default
# parent for the rest). Defaults to BOT_HISTORY_DIR, so existing installs move nothing.
# BOT_STATE_DIR=

# Daily summaries, schedules, job history.
# BOT_HISTORY_DIR=.bot-history
# Inbound files. Worth pointing OUTSIDE any git repo — these are arbitrary
# user-supplied binaries, and a working tree loses them to `git clean -x`.
# BOT_ATTACHMENTS_DIR=          # default: <state>/attachments
# BOT_OUTBOX_DIR=               # default: <history>/outbox

# Background summarization. 0 disables it.
# SUMMARIZE_INTERVAL_MS=0
# SUMMARIZE_CHANNELS=           # default: MONITOR_CHANNELS
# Also summarize DMs and any channel the bot has actually spoken in. Without
# this, a DM conversation is never written down and /remember cannot find it.
# SUMMARIZE_SEEN_CHANNELS=true
# SUMMARIZE_BATCH_SIZE=200
# SUMMARY_LOOKBACK_HOURS=48     # how much summary history is injected
# SUMMARIZE_TIMEOUT_MS=120000   # wall clock for one summarization run
# BOT_SUMMARIZER_START_DELAY_MS=10000

# Rolling conversation buffer.
# BUFFER_MAX_BYTES=32768
# BUFFER_ROTATE_PERCENT=40      # oldest N% summarized away on rotation
# BUFFER_TRUNCATE_RESPONSE=500  # chars of each bot reply kept in the buffer

# ── Files ─────────────────────────────────────────────────────────────────────

# All types are supported both ways; these only tune the limits.
# MAX_ATTACHMENT_BYTES=26214400        # 25MB inbound
# MAX_OUTBOUND_BYTES=8388608           # 8MB outbound (Discord's own cap is lower)
# ATTACHMENT_FETCH_TIMEOUT_MS=60000
# BOT_OUTBOX_MTIME_TOLERANCE_MS=2000   # clock-skew slack when detecting new files
# Types the bot may hand back by NAMING a path, without the outbox or a marker.
# Widen with care: a broad list attaches every document a bot merely mentions.
# BOT_ATTACH_EXTENSIONS=csv,pdf,xlsx,png,jpg

# ── Reactions ─────────────────────────────────────────────────────────────────

# Requires ALLOWED_USERS to be non-empty; the handler refuses to register without it.
# REACTION_HANDLER_ENABLED=false
# REACTION_TRIGGER_EMOJI=👍
# REACTION_ACK_EMOJI=✅
# REACTION_FAIL_EMOJI=❌

# ── Scheduler ─────────────────────────────────────────────────────────────────

# Cron-style jobs live in <history>/schedules.json. Times are local to BOT_TIMEZONE.
# BOT_SCHEDULE_CHECK_MS=60000
# BOT_SCHEDULE_LOOKBACK_MINUTES=5   # how far back a missed run is recovered
# BOT_MAX_SCHEDULED_JOBS=25
# BOT_MAX_WAKE_ATTEMPTS=12          # looks a self-re-arming follow-up gets before it must stop
# BOT_WAKE_CARRY_MAX_MS=1800000     # how long follow-ups may keep resuming the conversation (default: SESSION_TIMEOUT_MS)

# --- Waking a bot when something happens (signals) ---
# Anything that can run a command can wake a waiting follow-up:
#   npm run signal dev-deploy-done
# Accepted on loopback by default. A bridge bound anywhere else must set a token,
# because a signal starts a run rather than just posting text.
# BRIDGE_TOKEN=
# BRIDGE_SIGNAL_MEMORY_MS=300000    # how long a signal with nothing waiting is remembered
# BRIDGE_SIGNAL_DATA_MAX=2000       # characters of attached text kept before truncation

# ── Paperclip board ───────────────────────────────────────────────────────────
#
# The Paperclip connector: answer tasks assigned to this bot on a Paperclip
# board. Off unless both are set. The prerequisite for a Paperclip-only bot.
# PAPERCLIP_URL=https://board.example.com
# PAPERCLIP_API_KEY=
# Run a task once more after a restart cut its answer off (1), instead of
# leaving it blocked with the fallback reply. Only for idempotent work.
# PAPERCLIP_RESUME_INTERRUPTED=1
# What lets a wake start the model (docs/model-work-triggers.md).
# Card statuses a new ask starts work in; unset, every status but backlog.
# PAPERCLIP_INTAKE=todo,in_progress,blocked
# Looks again at an ask answered as waiting; unset or off, the note answers it.
# PAPERCLIP_REWAKE=off
# Tasks whose description's first line matches belong to another writer:
# comment only, never a status.
# PAPERCLIP_EXTERNAL_WRITER=^source: \S+#\d+$
# Hand-offs through the shared escalate action, for one board; URL and bearer both or neither.
# PAPERCLIP_ESCALATE_URL=https://mcp.example.com/process/mcp
# PAPERCLIP_ESCALATE_BEARER_ENV=BOT_MCP_ROUTER_BEARER
# The board it serves, by origin, when not the first board.
# PAPERCLIP_ESCALATE_BOARD=https://board.example.com
# How a board run executes. readonly (default): read-only tools in CLAUDE_CWD.
# engineering: edit, write and a sandboxed shell, Discord memory still closed.
# parity: the bot's Discord session as-is, less DISCORD_TOKEN/BRIDGE_TOKEN and
# other channels' conversation — only when board readers are Discord's people.
# See docs/paperclip-board-execution.md.
# BOT_BOARD_EXECUTION=readonly
# BOT_BOARD_ENGINEERING_TOOLS=Read,Glob,Grep,Edit,Write,Bash
# BOT_BOARD_READ_PATHS=/srv/code/other-repo      # engineering: absolute, comma-separated
# BOT_BOARD_WRITE_PATHS=/srv/scratch              # engineering: absolute, comma-separated
# BOT_BOARD_NETWORK_ALLOW=github.com,api.github.com
# Credential files a board run may not read, added to the built-in list (.mcp.json,
# .env, .env.*, keys, .npmrc, ...), either mode. File-name patterns; ! exempts one.
# BOT_BOARD_DENY_FILES=*.secret,!public.key

# ── WebSocket bridge ──────────────────────────────────────────────────────────

# Lets an external agent post into this bot's channels. Loopback by default: it
# accepts commands, so exposing it must be deliberate. Unique port per bot.
# WS_PORT=9800
# WS_HOST=127.0.0.1
# WS_HEARTBEAT_MS=30000
# WS_HEARTBEAT_MAX_MISSES=3

# ── Misc ──────────────────────────────────────────────────────────────────────

# LOG_LEVEL=info                 # debug, info, warn, error
# NODE_ENV=production            # disables pretty logging
# MAX_DISCORD_LENGTH=1900        # chars per message before splitting
# BOT_TYPING_INTERVAL_MS=8000    # typing-indicator refresh
# Live status line while the bot works. Reports ACTIVITY only — never the reply
# text (which is always delivered once, at the end) and never tool inputs.
# BOT_PROGRESS_ENABLED=true
# BOT_PROGRESS_INTERVAL_MS=2500  # coalesced, to stay inside Discord rate limits
# BOT_PROGRESS_FIRST_MS=800      # how fast the FIRST update appears
# Words that halt a run in flight. Bare `stop` halts every bot in the channel;
# `stop x, y, z` also halts, but only while something is actually running.
# BOT_STOP_WORDS=stop,halt,abort,cancel
# BOT_START_CONFIRM_MS=2000      # how long `npm start` waits before judging
# BOT_STOP_TIMEOUT_MS=5000       # graceful wait before `npm stop` force-kills
# BOT_BOT_EXCHANGE_PRUNE_MS=600000
